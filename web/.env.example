# Use a fixed public URL and HTTPS in deployment.
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 48; never commit the value.
BETTER_AUTH_SECRET=
# From the GitHub App registration (not a separate OAuth App).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App URL slug (github.com/apps/<slug>) for installation/selection flow.
GITHUB_APP_SLUG=
# From your GitLab.com OAuth application.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Absolute path in a durable, permission-restricted volume, outside Git worktrees.
NT_STUDIO_DB_PATH=
# Independent AES-256-GCM key for encrypted per-user Pi credentials; store outside the database backup.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NT_PI_CREDENTIAL_KEY=
# Absolute path to the evictable Git cache volume, separate from durable job state.
# Required when creating GitHub job worktrees. Never put this inside the Studio DB/state directory.
NT_GIT_CACHE_DIR=
# Native NovelTea executable used to validate new canonical Stories before
# any GitLab remote writes (issue #49). Must be installed on the Studio host.
NT_NATIVE_CLI=
# Optional trusted skills checkout for server-owned fixture generation (#59).
# Never accept a client-supplied skills path. Real Pi remains disabled.
NT_STUDIO_SKILLS_SOURCE=
