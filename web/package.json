{
  "name": "@noveltea/studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node ../scripts/check-studio-oauth-bundle.mjs",
    "start": "node .output/server/index.mjs",
    "typecheck": "vite build && tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "check": "pnpm db:check && pnpm typecheck && pnpm test",
    "migrate": "tsx src/db/migrate-cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "host:controller": "tsx src/host-controller.ts",
    "agent:worker": "tsx src/agent-worker.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@xyflow/react": "12.10.0",
    "better-auth": "1.7.14",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.66.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shadcn": "^4.23.0",
    "simple-icons": "16.36.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.9",
    "nitro": "3.0.261029-rc",
    "tailwindcss": "^4.3.4",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  }
}
