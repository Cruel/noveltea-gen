{
  "name": "noveltea-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first NovelTea generation orchestration proof of concept",
  "bin": {
    "noveltea-gen": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/check-source-quality.mjs && pnpm --filter @noveltea/studio persistence:boundary",
    "format": "prettier --write src test web/src web/test scripts",
    "format:check": "prettier --check .prettierrc.json scripts/check-source-quality.mjs web/test/support/studio-seed.ts",
    "test": "tsx --test test/*.test.ts",
    "test:offline": "tsx --test test/cli.test.ts test/demo.test.ts test/graph.test.ts test/generation-shards.test.ts test/studio-shards.test.ts test/langsmith-config.test.ts test/local-trace.test.ts test/pi-delegation.test.ts test/pinned-skill-reads.test.ts test/project.test.ts test/recovery-compatibility.test.ts test/resources.test.ts test/sandbox-pi-tools.test.ts test/skills.test.ts test/snapshot.test.ts test/specialist-author-instruction.test.ts test/tracing.test.ts",
    "certify": "tsx --test test/certification.test.ts",
    "certify:story": "node scripts/certify-story.mjs",
    "certify:new-story": "tsx scripts/certify-new-story.ts",
    "certify:self-hosted": "node scripts/certify-self-hosted.mjs",
    "certify:compose": "tsx scripts/certify-compose.ts",
    "certify:postgres-compose": "tsx scripts/certify-postgres-compose.ts",
    "certify:studio-compose": "tsx scripts/certify-studio-compose.ts",
    "certify:postgres-transactions": "tsx scripts/certify-postgres-transactions.ts",
    "certify:postgres-conformance": "tsx scripts/certify-postgres-transactions.ts --conformance",
    "test:live": "NT_LIVE_TEST=1 tsx --test test/live.test.ts",
    "studio": "LANGSMITH_TRACING=false LANGCHAIN_TRACING_V2=false TRACE_TO_LANGSMITH=false langgraphjs dev --no-browser --n-jobs-per-worker 1",
    "studio:trace": "NT_STUDIO_TRACE=1 LANGSMITH_TRACING=true LANGCHAIN_TRACING_V2=true TRACE_TO_LANGSMITH=true langgraphjs dev --no-browser --n-jobs-per-worker 1",
    "studio:input": "tsx src/studio-input.ts",
    "trace:show": "tsx src/trace-show.ts",
    "replay:step": "tsx scripts/replay-execution.ts",
    "story:snapshots": "tsx scripts/story-debug-snapshots.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @noveltea/studio check"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.0",
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@langchain/langsmith-pi-extension": "0.2.1",
    "esbuild": "0.28.2",
    "jsonrepair": "3.15.0",
    "langsmith": "0.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.5.5",
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
