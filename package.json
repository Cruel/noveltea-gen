{
  "name": "noveltea-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first NovelTea generation orchestration proof of concept",
  "bin": { "noveltea-gen": "./dist/cli.js" },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "NT_LIVE_TEST=1 tsx --test test/live.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@11.15.0",
  "dependencies": {
    "@langchain/langgraph": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
